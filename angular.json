{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": { "analytics": false },
  "projects": {
    "gallery": {
      "projectType": "application",
      "root": "client",
      "sourceRoot": "client/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/client",
            "index": "client/src/index.html",
            "browser": "client/src/main.ts",
            "tsConfig": "client/tsconfig.app.json",
            "styles": ["client/src/styles.css"],
            "assets": [{ "glob": "**/*", "input": "client/public" }]
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": false
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "750kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "client/tsconfig.spec.json",
            "runner": "vitest"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "proxyConfig": "client/proxy.conf.json", "port": 4200 },
          "configurations": {
            "development": { "buildTarget": "gallery:build:development" },
            "production": { "buildTarget": "gallery:build:production" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
