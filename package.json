{
  "name": "gallery-web-app",
  "version": "2.0.0",
  "private": true,
  "description": "An Angular and TypeScript gallery with Express, PostgreSQL, MongoDB, and Redis.",
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": true
    }
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/server/src/server.js",
    "dev": "concurrently -k -n api,client \"npm:dev:api\" \"npm:dev:client\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch server/src/server.ts",
    "dev:client": "ng serve",
    "build": "npm run build:api && npm run build:client",
    "build:api": "tsc -p tsconfig.server.json",
    "build:client": "ng build",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "maintenance": "node --env-file-if-exists=.env --import tsx scripts/maintenance.ts",
    "seed:hosted": "node --env-file-if-exists=.env --import tsx scripts/seed-hosted.ts",
    "seed:community": "node --env-file-if-exists=.env --import tsx scripts/seed-community.ts",
    "seed:art-forms": "node --env-file-if-exists=.env --import tsx scripts/seed-art-forms.ts",
    "seed:art-forms:apply": "node --env-file-if-exists=.env --import tsx scripts/seed-art-forms.ts --apply",
    "mongo:prepare": "node --env-file-if-exists=.env --import tsx scripts/prepare-mongodb.ts",
    "artworks:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate-artworks.ts",
    "worker": "node --env-file-if-exists=.env dist/scripts/notification-worker.js",
    "notifications:process": "node --env-file-if-exists=.env --import tsx scripts/process-notifications.ts",
    "test": "npm run test:api && npm run test:client",
    "test:api": "node --import tsx --test test/*.test.ts",
    "test:client": "ng test --watch=false",
    "test:redis": "node --env-file-if-exists=.env.test --import tsx --test test/redis.integration.test.ts test/security-cache.test.ts test/notification-queue.integration.test.ts",
    "check": "tsc -p tsconfig.server.json --noEmit && ng build --configuration development",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "node --import tsx scripts/demo.ts",
    "images:repair": "node --env-file-if-exists=.env --import tsx scripts/repair-collection-images.ts"
  },
  "dependencies": {
    "@angular/common": "^21.2.24",
    "@angular/compiler": "^21.2.24",
    "@angular/core": "^21.2.24",
    "@angular/forms": "^21.2.24",
    "@angular/platform-browser": "^21.2.24",
    "@angular/router": "^21.2.24",
    "@google-cloud/firestore": "9.3.1",
    "@ngrx/signals": "^21.1.1",
    "@supabase/supabase-js": "2.117.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.11",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "7.7.0",
    "pg": "8.23.1",
    "redis": "^6.3.0",
    "rxjs": "^7.8.2",
    "svix": "^2.6.1",
    "tslib": "^2.8.1"
  },
  "overrides": {
    "piscina": "^5.3.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.24",
    "@electric-sql/pglite": "0.5.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "9.10.4",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.8"
  }
}
