{
  "name": "gallery-web-app",
  "version": "1.0.0",
  "private": true,
  "description": "An Express and MongoDB gallery for artwork, reviews, and artist workshops.",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "seed": "node --env-file-if-exists=.env database-initializer.js",
    "test": "node --test",
    "check": "node scripts/check.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "connect-mongo": "^5.1.0",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "mongoose": "^6.13.11",
    "multer": "^2.4.0",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.8.0",
    "supertest": "^7.2.2"
  }
}
