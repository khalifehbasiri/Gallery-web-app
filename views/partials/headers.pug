nav#header(aria-label="Main navigation")
    a(href="/home") Home
    if session && session.loggedin
        a(href="/artwork") Artwork
        a(href="/searchArt") Search
        a(href="/account") Account
        a(href="/logout") Logout
    else
        a(href="/register") Register
        form(action="/login", method="post")
            label(for="loginUsername") Username
            input#loginUsername(type="text", name="username", maxlength="80", autocomplete="username", required)
            label(for="loginPassword") Password
            input#loginPassword(type="password", name="password", maxlength="256", autocomplete="current-password", required)
            button(type="submit") Login
