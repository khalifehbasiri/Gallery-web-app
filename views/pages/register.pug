extends ../layout

block title
    title Register User

block scripts
    script(src="/register.js", defer)

block content
    h1 Register
    #error(role="alert")
    label(for="name") Username
    input#name(type="text", maxlength="80", autocomplete="username", required)
    label(for="pass") Password (at least 8 characters)
    input#pass(type="password", minlength="8", maxlength="256", autocomplete="new-password", required)
    button#submit(type="button") Register
