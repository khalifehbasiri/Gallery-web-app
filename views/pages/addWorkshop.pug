extends ../layout

block title
    title Add Workshop

block scripts
    script(src="/addWorkshop.js", defer)

block content
    h1 Add Workshop
    label(for="Wname") Name
    input#Wname(type="text", maxlength="200", required)
    label(for="Wgoal") Goal
    input#Wgoal(type="text", maxlength="2000", required)
    label(for="Wduration") Duration (weeks)
    input#Wduration(type="number", min="1", max="9999", required)
    button#Wadd(type="button", onclick="add_workshop()") Add
