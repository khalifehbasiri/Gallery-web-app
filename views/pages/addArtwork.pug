extends ../layout

block title
    title Add Artwork

block scripts
    script(src="/addArt.js", defer)

block content
    h1 Add Artwork
    label(for="Aname") Name
    input#Aname(type="text", maxlength="200", required)
    label(for="Ayear") Year
    input#Ayear(type="number", min="0", max="9999", required)
    label(for="Acategory") Category
    input#Acategory(type="text", maxlength="200", required)
    label(for="Amedium") Medium
    input#Amedium(type="text", maxlength="200", required)
    label(for="Adescription") Description
    textarea#Adescription(maxlength="10000", required)
    label(for="Aimage") Image (PNG, JPEG, GIF, or WebP; up to 5 MB)
    input#Aimage(type="file", accept="image/png,image/jpeg,image/gif,image/webp", required)
    button#Aadd(type="button", onclick="add_art()") Add
