extends ../layout
include ../mixins/artwork

block title
    title Account

block scripts
    script(src="/changeType.js", defer)

block content
    h1 Account info
    p Username: #{user.username}
    p Account type: #{user.aType}
    button#accType(type="button") Change account type

    h2 Following
    if user.following.length
        ul
            each followed in user.following
                li
                    a(href=`/artist/${followed._id}`) #{followed.username}
    else
        p You are not following anyone yet.

    h2 Likes
    if user.like.length
        ul
            each artwork in user.like
                li
                    a(href=`/art/${artwork._id}`) #{artwork.name}
    else
        p You haven't liked any artworks yet.

    h2 Reviews
    if user.reviews.length
        ul
            each review in user.reviews
                li
                    a(href=`/art/${review.artId}`) #{review.review}
    else
        p You have not posted any reviews yet.

    if user.aType === 'artist'
        h2 Workshops
        a(href="/addWorkshop") Add Workshop
        each workshop in user.workshops
            p Name: #{workshop.name}, Goal: #{workshop.goal}, Duration: #{workshop.duration} weeks, Signed by #{(workshop.signed || []).length}
        if !user.workshops.length
            p No workshops yet.

        h2 Artwork
        a(href="/addArtwork") Add Artwork
        each artwork, index in art
            +artworkCard(artwork, index)
        if !art.length
            p No artwork yet.
