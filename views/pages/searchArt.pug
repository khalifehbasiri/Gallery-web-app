extends ../layout
include ../mixins/artwork

block title
    title Search Art

block scripts
    script(src="/search.js", defer)

block content
    h1 Search Art
    p Enter a name, artist, or category. Results match all supplied fields exactly.
    label(for="Sname") Name
    input#Sname(type="text", placeholder="name...", maxlength="200")
    label(for="Sartist") Artist
    input#Sartist(type="text", placeholder="artist...", maxlength="200")
    label(for="Scategory") Category
    input#Scategory(type="text", placeholder="category...", maxlength="200")
    button#search(type="button", onclick="search()") Search
    each artwork, index in art
        +artworkCard(artwork, index)
    if !art.length
        p No results. Try searching above.
