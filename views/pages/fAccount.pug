extends ../layout
include ../mixins/artwork

block title
    title= followed.username

block content
    h1 Artist
    p Name: #{followed.username}
    if followed.aType === 'artist' && followed.username !== user.username
        - const following = user.following.some(person => person.username === followed.username)
        if following
            button#unfollow(type="button", data-username=followed.username, onclick="unfollow(this.dataset.username)") Unfollow
        else
            button#follow(type="button", value=followed._id, onclick="follow(this.value)") Follow

    h2 Workshops
    each workshop in followed.workshops
        - const signedByYou = (workshop.signed || []).some(person => person.name === user.username)
        p Name: #{workshop.name}, Goal: #{workshop.goal}, Duration: #{workshop.duration} weeks
        if signedByYou
            p You have already signed up
        else
            button(type="button", data-name=workshop.name, data-user=followed.username, onclick="signup(this)") Sign up
    if !followed.workshops.length
        p No workshops found.

    h2 Art
    each artwork, index in art
        +artworkCard(artwork, index)
    if !art.length
        p No art found.
