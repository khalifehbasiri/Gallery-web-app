rules_version = '2';
// artworks/{id}: id, artistId, title, year, category, medium, description,
// imageUrl are strings. Express validates and publishes immutable documents.
// Server SDK access uses IAM; there is no Firebase-authenticated browser client.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
