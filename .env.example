MONGODB_URI=mongodb://127.0.0.1:27017/TP
PORT=3000
# Generate a value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Set to production only when serving over HTTPS.
NODE_ENV=development
# Set to 1 only when running behind one trusted reverse proxy.
TRUST_PROXY=0
# Browser origin allowed to send mutations during Angular development.
CLIENT_ORIGIN=http://localhost:4200
# Optional discovery cache. Leave blank to run entirely on MongoDB.
# Use rediss:// for a hosted Redis service with TLS. Keep credentials in .env.
REDIS_URL=
REDIS_CACHE_TTL_SECONDS=60
REDIS_KEY_PREFIX=gallery-web-app
