# Node 22.14–22.x. Real credentials belong in ignored .env only.
PORT=3000
NODE_ENV=development
TRUST_PROXY=0
CLIENT_ORIGIN=http://localhost:4200
JWT_SECRET=
DATABASE_URL=
# Single-quoted trusted CA PEM, including literal newlines.
DATABASE_CA_CERT=
# Live artwork documents; Atlas Free M0, server-only gallery database credentials.
MONGODB_URI=
MONGODB_DATABASE=gallery
ARTWORK_BACKEND=mongodb
# Temporarily pause image reservations/publication during a document-store cutover.
ARTWORK_WRITES_PAUSED=false
# Stable namespace shared by API/worker; preserve it across document-store changes.
REDIS_SCOPE_ID=gallery-web-app-kb-2026
# Retained only for the explicit Firestore export/rollback adapter.
FIREBASE_PROJECT_ID=
# Single-quote serialized JSON to preserve escaped newlines in private_key.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_DATABASE_ID=(default)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=gallery-images
# Both REST values, or neither. Preferred transport on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternative hosted TCP/TLS transport: rediss://
REDIS_URL=
REDIS_CACHE_TTL_SECONDS=60
REDIS_KEY_PREFIX=gallery-web-app
# Read-only exporter only, never the live application.
LEGACY_MONGODB_URI=
# Explicit trusted HTTPS hosts for operator-only prepare-assets.
MIGRATION_IMAGE_HOSTS=
# Optional verified, opt-in email notifications. Secrets are server-only.
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
# Public delivery requires a verified owned domain AND webhook secret.
RESEND_PUBLIC_SENDING=false
# Restricted test mode: Resend account email; use onboarding@resend.dev as From.
RESEND_TEST_RECIPIENT=
# Render Free HTTPS processor and independently generated shared authentication secret.
NOTIFICATION_WORKER_URL=
NOTIFICATION_WORKER_SECRET=
# Separate random 32+ character key shared only for encrypted email payloads.
NOTIFICATION_ENCRYPTION_KEY=
# Optional local operator convenience; Render receives this as DATABASE_URL.
NOTIFICATION_WORKER_DATABASE_URL=
# Authenticates the once-daily Hobby-compatible outbox recovery check.
CRON_SECRET=
